{
  "name": "@reusable-ui-tr/react-type-writer-effect",
  "version": "1.0.3",
  "description": "A React component for creating a typewriter effect with customizable options.",
  "keywords": [
    "react",
    "react-type-writer-effect",
    "type-writer-effect",
    "semih-ataman",
    "reusable-ui-tr"
  ],
  "author": "Semih Ataman",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/react-type-writer-effect.umd.cjs",
  "module": "./dist/react-type-writer-effect.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-type-writer-effect.js",
      "require": "./dist/react-type-writer-effect.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "unlink": "npm unlink -g @reusable-ui-tr/react-type-writer-effect",
    "link": "npm link",
    "major": "npm version major",
    "minor": "npm version minor",
    "patch": "npm version patch",
    "publish:local": "npm run unlink && npm run build && npm run link",
    "publish:npm": "npm publish --access public",
    "publish:major": "npm run major && npm run publish:npm",
    "publish:minor": "npm run minor && npm run publish:npm",
    "publish:patch": "npm run patch && npm run publish:npm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reusable-ui-tr/react-type-writer-effect.git"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.1.0"
  },
  "license": "MIT"
}
